@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@SENTRY_QML_STATIC_LIBRARY@)
    find_dependency(Qt6 6.8 COMPONENTS Core Gui Network Qml Quick)
    find_dependency(Qt6QmlPrivate 6.8 PATHS "${Qt6_DIR}/../Qt6QmlPrivate")
    if("@sentry_qml_backend@" STREQUAL "native")
        find_dependency(sentry CONFIG)
    endif()
else()
    find_dependency(Qt6 6.8 COMPONENTS Core Qml)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SentryQmlTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SentryQmlIntegration.cmake")
